# BhashaCall Environment Template
# Gnani.ai Great Indian AI Internship Challenge / Hackathon
# Copy to backend/.env and add your Gnani API key.

# ============================================================================
# GNANI.AI CREDENTIALS & MODELS
# ============================================================================
GNANI_API_KEY=

# Speech-to-Text: Prisma v3.0 (Multilingual Indic STT)
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=indic-auto
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream

# Text-to-Speech: Timbre v2.5 (Multilingual Indic TTS)
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_SPEED=1.0
GNANI_TTS_SAMPLE_RATE=48000
GNANI_TTS_TIMEOUT=90
GNANI_AUTH_HEADER=X-API-Key-ID
GNANI_AUTH_SCHEME=

# Set to true for automated tests or offline execution to conserve Gnani credits
GNANI_MOCK_MODE=false

# ============================================================================
# SIX SUPPORTED INDIAN LANGUAGES (BCP-47 LOCALES)
# ============================================================================
GNANI_STT_LANGUAGE_HI=hi-IN
GNANI_STT_LANGUAGE_EN=en-IN
GNANI_STT_LANGUAGE_BN=bn-IN
GNANI_STT_LANGUAGE_TA=ta-IN
GNANI_STT_LANGUAGE_TE=te-IN
GNANI_STT_LANGUAGE_MR=mr-IN

GNANI_TTS_LANGUAGE_HI=hi-IN
GNANI_TTS_LANGUAGE_EN=en-IN
GNANI_TTS_LANGUAGE_BN=bn-IN
GNANI_TTS_LANGUAGE_TA=ta-IN
GNANI_TTS_LANGUAGE_TE=te-IN
GNANI_TTS_LANGUAGE_MR=mr-IN

# ============================================================================
# VERIFIED GNANI TIMBRE V2.5 VOICES (from 42-voice catalogue)
# Default assignments:
# - Hindi: Nalini
# - English: Kaveri
# - Bengali: Mehuli
# - Tamil: Kavin
# - Telugu: Lavanya
# - Marathi: Asmita
# ============================================================================
GNANI_TTS_VOICE_HI=Nalini
GNANI_TTS_VOICE_EN=Kaveri
GNANI_TTS_VOICE_BN=Mehuli
GNANI_TTS_VOICE_TA=Kavin
GNANI_TTS_VOICE_TE=Lavanya
GNANI_TTS_VOICE_MR=Asmita

# ============================================================================
# TRANSLATION CONFIGURATION
# ============================================================================
# Built-in conversational dictionary covers all 6 language pairs offline.
# If an external translation endpoint is available, specify it below:
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
TRANSLATION_API_KEY=

# ============================================================================
# DOCUMENT PROCESSING & OPTIONAL TESSERACT OCR
# ============================================================================
OCR_LANGUAGES=eng+hin
OCR_DPI=300
OCR_MAX_PAGES=150
TESSERACT_CMD=

# ============================================================================
# SERVER & STORAGE
# ============================================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=52428800
MAX_EXTRACTED_CHARS=2000000
# DATABASE_PATH=./bhashacall.db
# DOCUMENT_STORAGE_PATH=./storage/documents
# AUDIO_STORAGE_PATH=./storage/audio
